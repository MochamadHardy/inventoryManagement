# ==========================================
# Root .gitignore untuk Multi-Branch Inventory & POS
# ==========================================

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor Files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak

# General Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# BACKEND (Laravel 11)
# ==========================================
backend/vendor/
backend/.env
backend/.env.backup
backend/.env.production
backend/.env.*.backup
backend/storage/*.key
backend/storage/logs/*.log
backend/storage/framework/cache/*
!backend/storage/framework/cache/.gitignore
backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitignore
backend/storage/framework/views/*
!backend/storage/framework/views/.gitignore
backend/storage/framework/testing/*
!backend/storage/framework/testing/.gitignore
backend/public/hot
backend/public/storage
backend/bootstrap/cache/*.php
!backend/bootstrap/cache/.gitignore
backend/.phpunit.cache/
backend/.phpunit.result.cache
backend/Homestead.json
backend/Homestead.yaml
backend/auth.json

# ==========================================
# FRONTEND (Vue 3 + Vite)
# ==========================================
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
frontend/.env.local
frontend/.env.*.local

# ==========================================
# PRIVATE / LOCAL-ONLY FOLDERS (Pribadi)
# ==========================================
Template/
docs/
